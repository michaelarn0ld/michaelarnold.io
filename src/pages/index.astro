---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Michael Arnold — currently away." />
    <meta name="theme-color" content="#09090b" />
    <title>Michael Arnold</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main class="viewport">
      <div class="shell">
        <!-- Top bar: identity + status -->
        <header class="top-bar">
          <span class="brand">michael arnold</span>
          <span class="status-pill" title="Status: Away">
            <span class="status-dot"></span>
            <span class="status-text">away</span>
          </span>
        </header>

        <!-- Message + dynamic typewriter + email CTA (centered) -->
        <section class="message-section" aria-label="Status message">
          <p class="greeting">sorry, couldn't get to you right now.</p>
          <div class="terminal-line" aria-live="polite">
            <span class="prompt-label">currently:</span>
            <span class="dynamic-wrap">
              <span id="typewriter" class="typewriter-text">offline.</span>
              <span class="cursor" aria-hidden="true">█</span>
            </span>
          </div>

          <div class="cta-wrapper">
            <a href="mailto:me@michaelarnold.io" class="email-cta">
              <span>email me</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </section>

        <!-- Invisible spacer to keep center optical alignment -->
        <div class="bottom-spacer" aria-hidden="true"></div>
      </div>
    </main>

    <script is:inline>
      (function () {
        const states = [
          'offline.',
          'afk.',
          'unplugged.',
          'outside.',
        ];

        function init() {
          const target = document.getElementById('typewriter');
          if (!target) return;

          let stateIdx = 0;
          let charIdx = states[0].length;
          let isDeleting = true;

          const typeSpeed = () => 65 + Math.random() * 30;
          const deleteSpeed = () => 35 + Math.random() * 20;

          function tick() {
            const currentWord = states[stateIdx];

            if (isDeleting) {
              charIdx--;
              target.textContent = currentWord.substring(0, charIdx);

              if (charIdx === 0) {
                isDeleting = false;
                stateIdx = (stateIdx + 1) % states.length;
                setTimeout(tick, 350);
                return;
              }
              setTimeout(tick, deleteSpeed());
            } else {
              charIdx++;
              target.textContent = currentWord.substring(0, charIdx);

              if (charIdx === currentWord.length) {
                isDeleting = true;
                setTimeout(tick, 2200);
                return;
              }
              setTimeout(tick, typeSpeed());
            }
          }

          setTimeout(tick, 1000);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #09090b;
        --border: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(255, 255, 255, 0.22);
        --text: #f4f4f5;
        --text-muted: #71717a;
        --text-dim: #a1a1aa;
        --accent: #f97316;
        --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, "Liberation Mono", monospace;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-mono);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      .viewport {
        min-height: 100dvh;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        padding: clamp(28px, 5vh, 48px) 24px;
        box-sizing: border-box;
      }

      .shell {
        width: 100%;
        max-width: 600px;
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      /* Top header */
      .top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }

      .brand {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-dim);
        letter-spacing: 0.02em;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 4px 10px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        border-radius: 999px;
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--accent);
        box-shadow: 0 0 8px rgba(249, 115, 22, 0.65);
        display: inline-block;
      }

      .status-text {
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
        text-transform: lowercase;
      }

      /* Message & typewriter (centered in viewport) */
      .message-section {
        margin: auto 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: 14px;
        line-height: 1.5;
        padding: 40px 0;
      }

      .greeting {
        font-size: clamp(1rem, 2.8vw, 1.25rem);
        color: var(--text-dim);
        font-weight: 400;
        letter-spacing: -0.01em;
      }

      .terminal-line {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: center;
        gap: 8px;
        font-size: clamp(1.05rem, 3.2vw, 1.35rem);
        color: var(--text);
        min-height: 1.6em;
      }

      .prompt-label {
        color: var(--text-muted);
      }

      .dynamic-wrap {
        display: inline-flex;
        align-items: baseline;
      }

      .typewriter-text {
        color: var(--text);
        font-weight: 500;
      }

      .cursor {
        display: inline-block;
        margin-left: 3px;
        color: var(--accent);
        font-size: 0.88em;
        line-height: 1;
        animation: blink 1.05s steps(1) infinite;
        user-select: none;
      }

      @keyframes blink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }

      /* Email Call To Action */
      .cta-wrapper {
        margin-top: 10px;
      }

      .email-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        font-size: 0.85rem;
        color: var(--text);
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        border-radius: 999px;
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
        min-height: 44px;
      }

      @media (hover: hover) {
        .email-cta:hover {
          background: rgba(255, 255, 255, 0.07);
          border-color: var(--border-hover);
          transform: translateY(-1px);
        }

        .email-cta:hover .arrow {
          transform: translateX(3px);
        }
      }

      .email-cta:focus-visible {
        outline: none;
        border-color: var(--accent);
      }

      .email-cta .arrow {
        color: var(--accent);
        transition: transform 0.2s ease;
      }

      /* Bottom spacer matches top-bar height for optical centering */
      .bottom-spacer {
        height: 28px;
        width: 100%;
        pointer-events: none;
      }



      /* Mobile fine-tuning */
      @media (max-width: 480px) {
        .viewport {
          padding: 24px 20px 32px 20px;
        }

        .message-section {
          gap: 12px;
          padding: 24px 0;
        }

        .terminal-line {
          gap: 6px;
        }
      }
    </style>
  </body>
</html>
