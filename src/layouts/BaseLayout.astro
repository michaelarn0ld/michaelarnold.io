---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Michael Arnold',
  description = 'Personal site of Michael Arnold — software engineer, writing and photography.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="container">
      <slot />
      <footer>© {new Date().getFullYear()} Michael Arnold</footer>
    </div>
  </body>
</html>
