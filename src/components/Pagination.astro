---
// Client-side pagination controls. Wired up by collectionFilter.ts.
---

<div class="pagination">
  <button type="button" data-role="prev" aria-label="Previous page">← Prev</button>
  <span class="page-info" data-role="page-info">Page 1</span>
  <button type="button" data-role="next" aria-label="Next page">Next →</button>
</div>
